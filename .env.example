# Provider keys (only the ones you use)
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Model per role, format "<provider>:<model>". Providers: groq, ollama, openrouter, anthropic
PLANNER_MODEL=groq:openai/gpt-oss-120b
TOOLSMITH_MODEL=groq:openai/gpt-oss-120b
WORKER_MODEL=groq:openai/gpt-oss-20b

# Limits (tuned for Groq free tier)
MAX_CONCURRENT_LLM_CALLS=2
MAX_PARALLEL_STEPS=2
MAX_LOOP_STEPS=12
TOOL_RESULT_MAX_CHARS=4000

# Human-in-the-loop. "none" = ask for everything; "safe" = auto-approve plans;
# "all" = auto-approve plans and risky tool calls (used by evals)
AUTO_APPROVE=none

# Storage
DB_PATH=data/sea.db
WORKSPACES_DIR=workspaces
SANDBOX_IMAGE=sea-sandbox

# Telegram alerts for watches. Get a token from @BotFather, then run:
#   sea watch setup-telegram --token <token>
# which fills in the chat id for you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
